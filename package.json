{
  "name": "finanzas-familiares-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fixed-seed synthetic family-finance control demonstration",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mutation": "node scripts/mutation-test.mjs",
    "test:contrast": "node scripts/contrast-check.mjs",
    "scan:privacy": "node scripts/privacy-scan.mjs",
    "verify": "node scripts/verify.mjs && npm test && npm run test:mutation && npm run test:contrast && npm run scan:privacy",
    "build": "python -B scripts/build.py",
    "render": "node design/render.mjs"
  },
  "devDependencies": { "playwright-core": "1.62.1" },
  "engines": { "node": ">=20", "python": ">=3.10" }
}
